# RED QUEEN agent
OPENAI_API_KEY=your_openai_api_key
OPENAI_AGENT_MODEL=gpt-4o-mini
NEXT_PUBLIC_AGENT_NAME=RED QUEEN

# Supabase Auth + persistence
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
# SERVER ONLY — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
WALLET_SALT=replace_with_a_long_random_server_secret

# Solana RPC
NEXT_PUBLIC_SOLANA_RPC_URL=https://your-browser-safe-mainnet-rpc.example
SOLANA_RPC_URL=https://your-server-mainnet-rpc.example

# Broad-area geocoding for Local Pulse. Keep provider swappable and use a valid
# application identifier. Never submit exact addresses or confidential data.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=RED-QUEEN-Survival-Intelligence/1.0 (https://redqueen.space)

# Optional but recommended: free NASA FIRMS key for granular active-fire map data.
FIRMS_MAP_KEY=

# Solana x402 Paywall Configuration
# Public receiving address for USDC payments
SVM_ADDRESS=your_solana_wallet_address_here
# Solana Network CAIP-2: 'solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1' for Devnet, 'solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp' for Mainnet
SVM_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp

# Recommended for production facilitator capacity. The public PayAI tier works
# without credentials, but an authenticated merchant account has higher limits.
PAYAI_API_KEY_ID=
PAYAI_API_KEY_SECRET=
PAYAI_FACILITATOR_URL=https://facilitator.payai.network

# Optional premium survival-intelligence procurement — SERVER ONLY.
# Existing x402 products remain available without these values. Premium Area
# Intelligence is exposed only when the required Off-Nadir provider is ready.
OFF_NADIR_API_KEY=
OFF_NADIR_BASE_URL=https://offnadir-delta.com/api/v1
OPENWEATHER_API_KEY=

# Queen Buyer — SERVER ONLY. Use a dedicated, low-balance Solana keypair funded
# only with the USDC needed for approved upstream x402 calls. Never reuse the
# treasury key and never paste a seed phrase. Accepts a base58 64-byte keypair
# or a JSON array of exactly 64 bytes.
RED_QUEEN_BUYER_ADDRESS=GVf6gQpmAcc45aGxmFKu1mdVmyYcVKB7AckLAK1WVtFb
RED_QUEEN_BUYER_PRIVATE_KEY=
RED_QUEEN_BUYER_MAX_CALL_USDC=0.03
RED_QUEEN_BUYER_DAILY_LIMIT_USDC=1.00
# Agent402's current Solana recipient. A mismatch fails closed before signing.
AGENT402_EXPECTED_PAY_TO=J7aN3PLJnTCF5qpEnvJHJsnCjcGuqC2rYtEM8Gv3xwg

# Optional physical survival-market discovery. Cart creation is local and free;
# supplier discovery/checkout must remain separately approved by the user.
X402_MARKET_BASE_URL=https://x402-market.com
X402_MARKET_ENABLED=true

# Optional Amazon Creators API product cards — SERVER ONLY. Search links remain
# available when these values are absent. Use the Partner Tag for each locale.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_CREATORS_PARTNER_TAG=
AMAZON_ASSOCIATE_TAG_ES=
AMAZON_ASSOCIATE_TAG_US=

# Optional SP3ND Partner API fallback for future commission-bearing commerce.
# The primary SP3ND MCP flow uses OAuth and requires neither value.
SP3ND_PARTNER_MODE_ENABLED=false
SP3ND_API_KEY=
SP3ND_API_SECRET=
SP3ND_BASE_URL=https://us-central1-sp3nddotshop-prod.cloudfunctions.net

# Mainnet authority-changing actions remain off until the simulated revocation
# flow has been tested with a controlled wallet in the target deployment.
WALLET_LOCKDOWN_ENABLED=false

# Jupiter Swap V2 — required only for the public SOL/USDC -> $THREAT swap.
# The API key remains server-only. Referral fees are optional and disclosed.
JUPITER_API_KEY=your_jupiter_api_key
JUPITER_REFERRAL_ACCOUNT=
JUPITER_REFERRAL_FEE_BPS=

# Optional treasury automation — SERVER ONLY. Leave unset unless the protected
# buyback job is intentionally enabled and independently audited.
TREASURY_BUYBACK_ENABLED=false
TREASURY_PUBLIC_ADDRESS=your_treasury_public_address
TREASURY_PRIVATE_KEY=your_private_key_here

# Cron secret passcode to verify and secure buyback calls
CRON_SECRET=your_secret_passcode_here

# Admin access — comma-separated, server only
ADMIN_EMAILS=
ADMIN_WALLETS=

# RED QUEEN 8004 Agent Registry
# Public operational owner for the Agent Asset. Defaults to SVM_ADDRESS.
RED_QUEEN_AGENT_OWNER=your_project_solana_wallet_address
# Keep the canonical domain-hosted metadata URI unless the domain changes.
RED_QUEEN_AGENT_METADATA_URI=https://redqueen.space/.well-known/agent-registration.json
# Add both values only after the project wallet signs and the transaction is verified.
RED_QUEEN_AGENT_ASSET=
RED_QUEEN_AGENT_REGISTRATION_TX=


